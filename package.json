{
  "name": "posyandu-apps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"API,VITE,TUNNEL\" -c \"blue,green,magenta\" \"npm run server\" \"vite\" \"npm run tunnel\"",
    "dev:local": "concurrently -k -n \"API,VITE\" -c \"blue,green\" \"npm run server\" \"vite\"",
    "server": "npm run dev --prefix server",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sweetalert2": "^11.26.25",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5",
    "wrangler": "^4.154.0"
  }
}
